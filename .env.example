# Environment Configuration for SecureFileExchange
SECRET_KEY=secure-file-portal-super-secret-jwt-key-2026
JWT_EXPIRATION_HOURS=24

# Local MongoDB Connection (Matches MongoDB Compass default)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=fileexchange

# Maximum File Size (500 MB in bytes)
MAX_CONTENT_LENGTH=524288000
